<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Source generator: turns *.prompt.toml files into strongly typed C# prompt classes.</Description>
    <RootNamespace>TypedPrompt.CSharp.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Tomlyn" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TypedPrompt.Core\**\*.cs" Exclude="..\TypedPrompt.Core\bin\**;..\TypedPrompt.Core\obj\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TypedPrompt.CSharp.Generator.Tests" />
  </ItemGroup>

  <Target Name="CopyTomlynToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(PkgTomlyn)\lib\netstandard2.0\Tomlyn.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PkgTomlyn)\lib\netstandard2.0\Tomlyn.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

</Project>
